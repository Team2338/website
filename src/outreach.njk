---
title: Outreach
layout: base.njk
css: outreach.css
---
<header class="hero" style="--background: url('{{outreach.hero.img_url}}')">
    <p class="hero__typewriter">
        <span id="typed-text"></span>
        <span id="cursor">|</span>
    </p>
    <script src="/static/js/typewriter-outreach.js" defer></script>
    <h1 class="hero__title">{{ outreach.hero.heading }}</h1>
    <p class="hero__subtitle">{{ outreach.hero.subheading }}</p>
</header>
<section class="section">
    <div class="section__left">
        <h1 class="section__title">{{ outreach.section_1.heading | md | safe}}</h1>
        <p class="section__text">{{ outreach.section_1.paragraph | md | safe }}
        </p>
    </div>
    <div class="section__right">
        <img src="{{ outreach.section_1.img_url }}" alt="{{ outreach.section_1.img_alt }}" class="section__img">
    </div>
</section>
<section class="initiatives">
    <h3 class="initiatives__title">{{ outreach.initiatives_heading | md | safe }}</h3>

    <div class="initiatives__container">
        {% for initiative in outreach.initiatives %}
            <div class="initiatives__item">
                <div class="initiatives__item__overlay">
                    <h3 class="initiatives__item__overlay__title">{{initiative.name}}</h3>
                    <button class="initiatives__item__overlay__button" data-index="{{loop.index}}">Learn More</button>
                </div>
                <img src="{{initiative.image}}" alt="{{initiatives.alt}}" class="initiatives__item__img">
            </div>
            <dialog class="initiatives__popup" id="popup-{{loop.index}}" closedby="any">
                <div class="initiatives__popup__upper">
                    <h4 class="initiatives__popup__title">{{initiative.name}}</h4>
                    <form method="dialog">
                        <button autofocus class="initiatives__popup__close" data-index="{{loop.index}}">
                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="rgb(254, 80, 0)"><path d="m249-207-42-42 231-231-231-231 42-42 231 231 231-231 42 42-231 231 231 231-42 42-231-231-231 231Z"/></svg>
                        </button>
                    </form>
                </div>
                {{initiative.paragraph | md | safe}}
            </dialog>
        {% endfor %}
    </div>
    <script>
        const container = document.querySelector(".initiatives__container");
        //One event listener to simplfy and increase performance
        container.addEventListener("click", (e) => {
            let el = e.target;
            if (el.tagName === "BUTTON" && el.dataset.index) {
                document
                    .querySelector(`#popup-${el.dataset.index}`)
                    .showModal();
            }
        });
    </script>
</section>