---
title: "Team 2338: Gear It Forward"
layout: base.njk
css: index.css
---
{#IMPORTANT!!!!!!!!!!!!!!!!!!#}
{# ALWAYS SAVE FILE WITHOUT FORMATTING #}
<header class="hero">
    <div class="hero__background" style="--background-url: url('{{ home.hero_bg }}')"></div>
    <div class="hero__content">
        <p class="hero__content__subtitle">We are,</p>
        <h1>
            Team 
            <span class="hero__colored hero__colored--blue">2</span><span class="hero__colored hero__colored--orange">33</span><span class="hero__colored hero__colored--blue">8</span>: Gear It Forward
        <p class="hero__content__subtitle">A FIRST Robotics Competition team from Oswego, Illinois</p>
            <p class="typewriter hero__content__subtitle">
                <span id="typed-text"></span>
                <span id="cursor">|</span>
            </p>
            <script src="/static/js/typewriter-index.js" defer></script>
        </div>
    </header>

    <section class="section">
        <div class="section__left">
            <h2 class="section__subtitle">{{home.section_1.heading|md|safe}}</h2>
            <div class="section__text">
                {{ home.section_1.paragraph | md | safe}}
            </div>
        </div>
        <div class="section__right">
            <img src="{{ home.section_1.img_url }}" alt="{{ home.section_1.img_alt }}" class="section__img">
        </div>
    </section>

    <section class="section">
        <div class="section__left">
            <iframe src="{{ home.section_2.youtube_url }}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="section__video"></iframe>
        </div>
        <div class="section__right">
            <h2 class="section__subtitle">{{ home.section_2.heading | md |safe}}</h2>
            <dev class="section__text">{{ home.section_2.paragraph | md | safe}}</dev>
        </div>
    </section>

    <section class="sponsors">
        <h2 class="sponsors__title">Our Sponsors</h2>
        <p class="sponsors__subtitle">Thank you to our generous sponsors who make our team possible!</p>
        <div class="sponsors__grid">
            {% for sponsor in home.sponsors %}
                <a href="{{ sponsor.url }}" target="_blank" rel="noopener noreferrer" class="sponsor-card">
                    <img src="{{ sponsor.logo }}" alt="{{ sponsor.name }}" class="sponsor-card__logo">
                </a>
            {% endfor %}
        </div>
    </section>