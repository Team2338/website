permalink: /404.html
css: 404.css
eleventyExcludeFromCollections: true
---

<section class="error_page">
    <div class="error_page__container">
        <div class="error_page__content">
            <div class="error_page__text-wrapper">
                <h2 class="error_page__title">404 ERROR: <span> NOT FOUND!</span></h2>
                <h3 class="error_page__message">
                    Are you Lost? Click here to go to our homepage!
                    <br/>
                    <a href="/">Home</a>
                    <br/>
                    Garret's Dad "DadBot" Has a Joke for You!
                    <br/>
                    <span id="dad-joke">Loading joke...</span>
                </h3>
            </div>
        </div>
    </div>
</section>

<script>
    async function fetchDadJoke() {
        try {
            const response = await fetch('https://icanhazdadjoke.com/', {
                headers: {
                    'Accept': 'application/json'
                }
            });
            const data = await response.json();
            document
                .getElementById('dad-joke')
                .textContent = data.joke;
        } catch (error) {
            document
                .getElementById('dad-joke')
                .textContent = 'Sorry, couldn\'t load a joke right now!';
        }
    }
    fetchDadJoke();
</script>